	measure 'Devengado Comparable AA' = ```
			VAR _anio = MAX ( dim_anio[anio] )
			VAR _corte = [Mes Corte Comparable]
			VAR _meses = FILTER ( VALUES ( dim_calendario[mes_num] ), dim_calendario[mes_num] <= _corte )
			RETURN
			    CALCULATE ( [Devengado], REMOVEFILTERS ( dim_anio ), REMOVEFILTERS ( dim_calendario ), dim_anio[anio] = _anio - 1, _meses )
			```
