	measure 'Pliegos' = ```
			-- Entidad = pliego; en los gobiernos locales cada municipalidad (unidad ejecutora) es su propio pliego.
			VAR _t = SUMMARIZE ( FILTER ( fact_presupuesto_anual, fact_presupuesto_anual[monto_pim] <> 0 ),
			                     dim_entidad[nivel_gobierno_nombre], dim_entidad[pliego], dim_entidad[sec_ejec] )
			RETURN
			    COUNTROWS ( DISTINCT ( SELECTCOLUMNS ( _t, "entidad",
			        IF ( dim_entidad[nivel_gobierno_nombre] = "GOBIERNOS LOCALES", "M" & dim_entidad[sec_ejec], "P" & dim_entidad[pliego] ) ) ) ) + 0
			```
		formatString: #,0
		displayFolder: 9 Resumen
		lineageTag: dd30ce99-5592-5057-b86b-756e5016b93f

	measure 'Unidades Ejecutoras' = COUNTROWS ( SUMMARIZE ( FILTER ( fact_presupuesto_anual, fact_presupuesto_anual[monto_pim] <> 0 ), fact_presupuesto_anual[entidad_key] ) ) + 0
