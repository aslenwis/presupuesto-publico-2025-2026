	measure 'Diferencia Avance pp' = [Avance al Corte %] - [Avance al Corte AA %]
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 4 Interanual
		lineageTag: 5040dce8-cfb6-5797-a1f3-c2dc08b2919e

	measure 'Devengado al Ultimo Mes' = ```
			VAR _anio = MAX ( dim_anio[anio] )
			VAR _ult = LOOKUPVALUE ( dim_anio[mes_ultimo_dato], dim_anio[anio], _anio )
			RETURN
			    -- se conserva el año seleccionado: REMOVEFILTERS ( dim_calendario ) también quitaría el filtro de dim_anio
			    CALCULATE ( [Devengado], REMOVEFILTERS ( dim_calendario ), dim_calendario[anio] = _anio, dim_calendario[mes_num] <= _ult )
			```
		formatString: #,0
		displayFolder: 5 Proyeccion y metas
		lineageTag: afd808f1-0c75-5d2b-a80e-a425557022b7

	measure 'Cuota Estacional AA' = ```
			VAR _anio = MAX ( dim_anio[anio] )
			VAR _ult = LOOKUPVALUE ( dim_anio[mes_ultimo_dato], dim_anio[anio], _anio )
			VAR _parcial = CALCULATE ( [Devengado], REMOVEFILTERS ( dim_anio ), REMOVEFILTERS ( dim_calendario ), dim_anio[anio] = _anio - 1, dim_calendario[mes_num] <= _ult )
			VAR _total = CALCULATE ( [Devengado], REMOVEFILTERS ( dim_anio ), REMOVEFILTERS ( dim_calendario ), dim_anio[anio] = _anio - 1 )
			RETURN
			    DIVIDE ( _parcial, _total )
			```
		formatString: 0.0%
		displayFolder: 5 Proyeccion y metas
		lineageTag: 2077fc3d-87e9-54a5-9564-afab2963d101

	measure 'Devengado Proyectado' = ```
			VAR _anio = MAX ( dim_anio[anio] )
			VAR _ult = LOOKUPVALUE ( dim_anio[mes_ultimo_dato], dim_anio[anio], _anio )
			VAR _proy = IF ( _ult = 12, [Devengado al Ultimo Mes], DIVIDE ( [Devengado al Ultimo Mes], [Cuota Estacional AA] ) )
			RETURN
			    -- acotada al PIM: no se puede devengar más de lo presupuestado
			    IF ( ISBLANK ( _proy ), BLANK (), MIN ( _proy, [PIM] ) )
			```
		formatString: #,0
		displayFolder: 5 Proyeccion y metas
		lineageTag: 50d21998-682c-5e51-bbd5-b016e4627a09

	measure 'Avance Proyectado %' = DIVIDE ( [Devengado Proyectado], [PIM] )
		formatString: 0.0%
		displayFolder: 5 Proyeccion y metas
		lineageTag: eea1f6a7-9c03-5b76-b0c1-dcaaa1133929

	measure 'Avance Proyectado Mensual %' = ```
			VAR _anio = MAX ( dim_anio[anio] )
			VAR _ult = LOOKUPVALUE ( dim_anio[mes_ultimo_dato], dim_anio[anio], _anio )
			VAR _mes = MAX ( dim_calendario[mes_num] )
			VAR _acumAA = CALCULATE ( [Devengado], REMOVEFILTERS ( dim_anio ), REMOVEFILTERS ( dim_calendario ), dim_anio[anio] = _anio - 1, dim_calendario[mes_num] <= _mes )
			VAR _totalAA = CALCULATE ( [Devengado], REMOVEFILTERS ( dim_anio ), REMOVEFILTERS ( dim_calendario ), dim_anio[anio] = _anio - 1 )
			RETURN
			    IF ( _mes < _ult || _ult = 12, BLANK (), DIVIDE ( [Devengado Proyectado] * DIVIDE ( _acumAA, _totalAA ), [PIM] ) )
			```
		formatString: 0.0%
		displayFolder: 5 Proyeccion y metas
		lineageTag: cb1272a9-50cf-5d7c-8691-84ff9715dc60

	measure 'Meta Avance %' = ```
			VAR _anio = MAX ( dim_anio[anio] )
			RETURN
			    DIVIDE ( CALCULATE ( [Devengado Anual], REMOVEFILTERS ( dim_anio ), dim_anio[anio] = _anio - 1 ), [PIM AA] )
			```
		formatString: 0.0%
		displayFolder: 5 Proyeccion y metas
		lineageTag: df48da93-22c7-5795-9937-a4195694268a

