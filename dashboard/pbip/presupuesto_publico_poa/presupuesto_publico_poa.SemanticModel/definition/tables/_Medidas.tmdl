	measure 'Mes Corte Comparable' = CALCULATE ( MAX ( dim_anio[mes_corte_comparable] ), REMOVEFILTERS ( dim_anio ) )
		formatString: 0
		displayFolder: 2 Tiempo
		lineageTag: 3ebfc581-a815-570b-a1e3-4d17208c9419

	measure 'Mes Ultimo Dato' = LOOKUPVALUE ( dim_anio[mes_ultimo_dato], dim_anio[anio], MAX ( dim_anio[anio] ) )
		formatString: 0
		displayFolder: 2 Tiempo
		lineageTag: 1e9aa632-abf9-5105-9513-a24de9644955

	measure 'Devengado Acumulado' = ```
			VAR _anio = MAX ( dim_calendario[anio] )
			VAR _ultimo = LOOKUPVALUE ( dim_anio[mes_ultimo_dato], dim_anio[anio], _anio )
			VAR _mesMax = MIN ( MAX ( dim_calendario[mes_num] ), _ultimo )
			RETURN
			    IF (
			        MIN ( dim_calendario[mes_num] ) > _ultimo,
			        BLANK (),
			        CALCULATE ( [Devengado], REMOVEFILTERS ( dim_calendario ), dim_calendario[anio] = _anio, dim_calendario[mes_num] <= _mesMax )
			    )
			```
		formatString: #,0
		displayFolder: 2 Tiempo
		lineageTag: 7ef44e97-4d87-530d-a9af-f736e066ac31

	measure 'Devengado Acumulado AA' = ```
			VAR _anio = MAX ( dim_anio[anio] )
			VAR _mes = MAX ( dim_calendario[mes_num] )
			RETURN
			    CALCULATE ( [Devengado], REMOVEFILTERS ( dim_anio ), REMOVEFILTERS ( dim_calendario ), dim_anio[anio] = _anio - 1, dim_calendario[mes_num] <= _mes )
			```
		formatString: #,0
		displayFolder: 2 Tiempo
		lineageTag: f892ff16-2a98-5cad-ba5b-e42573896a89

	measure 'Devengado AA' = ```
			VAR _anio = MAX ( dim_anio[anio] )
			RETURN
			    CALCULATE ( [Devengado], REMOVEFILTERS ( dim_anio ), dim_anio[anio] = _anio - 1 )
			```
		formatString: #,0
		displayFolder: 2 Tiempo
		lineageTag: 88c6c88a-4541-535f-b0eb-03cb47e2e12b

	measure 'Texto Corte' = ```
			VAR _f = MAX ( dim_anio[fecha_ultimo_dato] )
			VAR _c = [Mes Corte Comparable]
			RETURN
			    "Datos al cierre de " & FORMAT ( _f, "mmmm yyyy" ) & "   |   Comparación interanual: enero a " & FORMAT ( DATE ( 2000, _c, 1 ), "mmmm" )
			```
		displayFolder: 2 Tiempo
		lineageTag: 69415f90-2ebe-529f-887f-2c3c17c4f44e

