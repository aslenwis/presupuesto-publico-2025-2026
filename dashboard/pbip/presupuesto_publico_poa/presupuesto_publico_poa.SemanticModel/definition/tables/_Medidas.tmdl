	measure 'Etapa %' = ```
			SWITCH (
			    SELECTEDVALUE ( dim_etapa[etapa] ),
			    "Certificado", [Certificacion %],
			    "Comprometido", [Compromiso %],
			    "Devengado", [Avance Anual %],
